# Vellakshya Environment Configuration Template
# Copy to .env and configure appropriate values

PORT=8000
ENVIRONMENT=development

# Database configuration (PostgreSQL with pgvector or SQLite fallback)
DATABASE_URL=postgresql://vellakshya:vellakshya_secret@localhost:5432/vellakshya_db

# Redis Cache and Rate Limiting (optional - degrades gracefully to memory if unreachable)
REDIS_URL=redis://localhost:6379/0

# LLM Providers (optional - deterministic offline fallback used for CI and unit tests)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
