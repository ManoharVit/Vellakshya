{
  "name": "vellakshya",
  "version": "1.0.0",
  "description": "Enterprise Document Workstation & PDF Intelligence System featuring in-browser pdf-lib processing, zero-backend Netlify Edge CDN deployment, and high-fidelity document assembly.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:api": "playwright test tests/api",
    "test:a11y": "playwright test tests/accessibility",
    "test:pdf": "playwright test tests/pdf-validation",
    "test:playwright": "playwright test",
    "test:load": "k6 run k6/load-test.js",
    "test:all": "npm run test:unit && npm run test:playwright"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManoharVit/Vellakshya.git"
  },
  "keywords": [
    "pdf",
    "pdf-editor",
    "pdf-workbench",
    "document-intelligence",
    "pdf-lib",
    "fastapi",
    "netlify"
  ],
  "author": "Giri Manohar Vemula <https://www.linkedin.com/in/manoharv511>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ManoharVit/Vellakshya/issues"
  },
  "homepage": "https://vellakshya.netlify.app/",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "vitest": "^5.0.5"
  }
}
